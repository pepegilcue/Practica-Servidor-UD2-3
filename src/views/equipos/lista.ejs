<%- include('../partials/cabecera') %>

<form method="get" action="/equipos">
  <label>Tipo
    <select name="tipo">
      <option value="todos">Todos</option>
      <option value="portatil" <%= filtros.tipo === 'portatil' ? 'selected' : '' %>>Portátil</option>
      <option value="sobremesa" <%= filtros.tipo === 'sobremesa' ? 'selected' : '' %>>Sobremesa</option>
    </select>
  </label>
  <label>
    <input type="checkbox" name="operativos" value="true" <%= filtros.operativos ? 'checked' : '' %>>
    Solo operativos
  </label>
  <button type="submit">Filtrar</button>
</form>

<% if (equipos.length === 0) { %>
  <p>No hay equipos con esos filtros.</p>
<% } else { %>
  <table border="1" cellpadding="4">
    <tr><th>Código</th><th>Nombre</th><th>Tipo</th><th>Estado</th><th></th></tr>
    <% equipos.forEach(function (e) { %>
      <tr>
        <td><%= e.codigo %></td>
        <td><%= e.nombre %></td>
        <td><%= e.tipo %></td>
        <td><%= e.estado %></td>
        <td><a href="/equipos/<%= e.id %>">Ver ficha</a></td>
      </tr>
    <% }) %>
  </table>
<% } %>
<%- include('../partials/pie') %>
