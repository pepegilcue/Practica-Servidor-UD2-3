<%- include('../partials/cabecera') %>
<ul>
  <li>Código: <%= equipo.codigo %></li>
  <li>Nombre: <%= equipo.nombre %></li>
  <li>Tipo: <%= equipo.tipo %></li>
  <li>Estado: <%= equipo.estado %></li>
